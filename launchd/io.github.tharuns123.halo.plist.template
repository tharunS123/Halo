<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.tharuns123.halo</string>

  <!-- Run the app binary directly, NOT `open`: launchd must own the process
       so it can supervise it, and so the bundle is the TCC identity. -->
  <key>ProgramArguments</key>
  <array>
    <string>__APP_BINARY__</string>
  </array>

  <key>RunAtLoad</key><true/>

  <!-- Restart if it crashes, but not when it exits cleanly (haloctl stop). -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HALO_SUPERVISE</key><string>1</string>
    <key>HALO_PROJECT_DIR</key><string>__PROJECT_DIR__</string>
  </dict>

  <key>StandardOutPath</key><string>__LOG_DIR__/overlay.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/overlay.log</string>

  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
