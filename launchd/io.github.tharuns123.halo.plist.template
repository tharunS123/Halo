<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.tharuns123.halo</string>

  <!-- Run the app binary directly, NOT `open`: launchd must own the process
       so it can supervise it, and so the bundle is the TCC identity. -->
  <key>ProgramArguments</key>
  <array>
    <string>__APP_BINARY__</string>
  </array>

  <key>RunAtLoad</key><true/>

  <!-- Restart if it crashes, but not when it exits cleanly (halo stop). -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HALO_SUPERVISE</key><string>1</string>
    <!-- The app cannot derive these: it lives in ~/Applications, not inside a
         checkout. Absolute paths, because launchd has no shell and no PATH
         worth trusting. -->
    <key>HALO_PYTHON</key><string>__PYTHON__</string>
    <key>HALO_ENGINE</key><string>__ENGINE__</string>
    <!-- launchd would otherwise hand us PATH=/usr/bin:/bin:/usr/sbin:/sbin,
         which does not include Homebrew, where whisper-cli lives. -->
    <key>PATH</key><string>__PATH__</string>
  </dict>

  <key>StandardOutPath</key><string>__LOG_DIR__/overlay.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/overlay.log</string>

  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
