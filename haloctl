#!/bin/bash
# Deprecated: haloctl is now `halo`. This shim keeps existing muscle memory and
# any scripts working for one release.
#
#   haloctl install  ->  halo setup
#   haloctl logs     ->  halo logs
#   ...everything else keeps its name.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CMD="${1:-}"
[ "$CMD" = "install" ] && CMD="setup"
shift 2>/dev/null || true

echo "note: haloctl is now 'halo'. Run: halo ${CMD:-setup} $*" >&2

if command -v halo >/dev/null 2>&1; then
  exec halo ${CMD:+"$CMD"} "$@"
fi
# Running from a checkout with no Homebrew install: use the local venv.
exec "$ROOT/.venv/bin/python" "$ROOT/cli.py" ${CMD:+"$CMD"} "$@"
